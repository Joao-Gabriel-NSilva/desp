rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para usuários: O próprio usuário pode ler e gravar seu próprio perfil.
    // Também permite leitura por membros do mesmo grupo familiar.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.familyId != null && resource.data.familyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regras para transações
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      // Permite ler se for o criador (owner) OU se o familyId da transação for igual ao familyId do usuário logado
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.familyId != null && resource.data.familyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId)
      );
      // Apenas o dono/criador da transação pode atualizar ou deletar
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    
    // Regras para famílias
    match /families/{familyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members || 
        request.auth.uid == resource.data.adminId ||
        (
          // Permite que um novo membro se adicione à lista
          request.resource.data.name == resource.data.name &&
          request.resource.data.adminId == resource.data.adminId &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        )
      );
    }

    // Regras para convites
    match /invitations/{invitationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.token.email == resource.data.toEmail ||
        request.auth.uid == resource.data.senderId
      );
    }
  }
}
